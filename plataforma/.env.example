# Neon (la integración Neon de Vercel la crea sola)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Auth0 → Applications → (Regular Web Application) → Settings
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Firma de la cookie de sesión: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Correos del equipo Pyxis-Bot que ven las solicitudes de demo de la landing (separados por coma)
SUPERADMIN_EMAILS=
# Opcional: URL pública fija (si no, se toma del dominio de la petición)
# APP_URL=https://robotmineropyxis-bot-dashboard.vercel.app
# Correo de invitaciones: usa Resend si hay RESEND_API_KEY + RESEND_FROM (dominio verificado);
# si no, Gmail con una contraseña de aplicación (https://myaccount.google.com/apppasswords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=Pyxis-Bot Robotics <invitaciones@tudominio.com>
